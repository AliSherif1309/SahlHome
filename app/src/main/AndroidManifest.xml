<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Sahl Union: shared with every Sahl app signed with the same key -->
    <permission android:name="com.sahl.permission.UNION" android:label="Sahl apps" android:protectionLevel="signature" />
    <uses-permission android:name="com.sahl.permission.UNION" />

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <package android:name="com.sahl.phone" />
        <package android:name="com.sahl.contacts" />
        <package android:name="com.sahl.messages" />
        <package android:name="com.sahl.adhan" />
        <package android:name="com.sahl.qibla" />
        <package android:name="com.aly.trueqibla" />
        <package android:name="com.sahl.files" />
        <package android:name="com.sahl.gallery" />
        <package android:name="com.sahl.camera" />
        <package android:name="com.sahl.tools" />
        <package android:name="com.aly.sahlsync" />
        <package android:name="com.sahl.pdf" />
        <package android:name="com.sahl.timer" />
        <provider android:authorities="com.sahl.adhan.union" />
        <provider android:authorities="com.sahl.contacts.union" />
        <provider android:authorities="com.sahl.phone.union" />
        <provider android:authorities="com.sahl.messages.union" />
        <provider android:authorities="com.sahl.files.union" />
        <provider android:authorities="com.sahl.tools.union" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SahlApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/SahlTheme">

        <!-- Sahl Home Theme, Widgets & 4K Wallpaper Studio (Does NOT hijack your system launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Sahl Wallpaper Studio (also appears in Android's system wallpaper picker) -->
        <activity
            android:name=".WallpaperActivity"
            android:exported="true"
            android:label="@string/wallpapers_title">
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Floating Emerald & Gold Folder Popup over your real home screen -->
        <activity
            android:name=".SahlPopupActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <!-- Configuration picker for the 1x1 Badgeless Sahl Icon Widget -->
        <activity
            android:name=".ThemedIconConfigureActivity"
            android:exported="true"
            android:label="@string/w_icon_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Widget 0: Sahl Analog Clock (2x2 Emerald & Gold Dial + Optional Hijri) -->
        <receiver
            android:name=".AnalogClockWidget"
            android:exported="true"
            android:label="@string/w_aclock_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_analog_clock_info" />
        </receiver>

        <!-- Widget 1: Sahl Islamic Clock (Live Clock, Hijri, Gregorian & Next Prayer) -->
        <receiver
            android:name=".ClockWidget"
            android:exported="true"
            android:label="@string/w_clock_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_clock_info" />
        </receiver>

        <!-- Widget 2: Sahl Islamic Sanctuary (Hijri, Daily Ayah & Adhkar) -->
        <receiver
            android:name=".SanctuaryWidget"
            android:exported="true"
            android:label="@string/w_sanctuary_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sahl.home.ACTION_CYCLE_AYAH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sanctuary_info" />
        </receiver>

        <!-- Widget 3: Sahl Union Hub (Live Clock, Next Prayer, Hijri, Search, Qibla, Tools & Sahl Apps) -->
        <receiver
            android:name=".UnionHubWidget"
            android:exported="true"
            android:label="@string/w_hub_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_union_hub_info" />
        </receiver>

        <!-- Widget 4: Sahl Apps Dock Bar (Phone, Messages, Adhan, Camera & Sahl Popup) -->
        <receiver
            android:name=".SahlBarWidget"
            android:exported="true"
            android:label="@string/w_bar_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sahl_bar_info" />
        </receiver>

        <!-- Widget 5: 1x1 Badgeless Sahl Emerald & Gold Icon (App or Folder — NO corner home logo!) -->
        <receiver
            android:name=".ThemedIconWidget"
            android:exported="true"
            android:label="@string/w_icon_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_themed_icon_info" />
        </receiver>

        <!-- Dynamic Prayer Sky Live Wallpaper Service -->
        <service
            android:name=".SahlLiveWallpaperService"
            android:exported="true"
            android:label="@string/live_wp_title"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/live_wallpaper" />
        </service>

        <!-- Live Notification Badge Listener for 1x1 App Widgets -->
        <service
            android:name=".BadgeListenerService"
            android:exported="true"
            android:label="@string/badge_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity android:name=".CrashActivity" android:exported="false" android:process=":crash" />
        <receiver android:name=".UpdateCheckReceiver" android:exported="false" />
    </application>
</manifest>
