<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_sanctuary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_sanctuary_hijri"
            android:fontFamily="@font/thmanyah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F5C84C"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_sanctuary_ref"
            android:fontFamily="@font/thmanyah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="11.5sp"
            android:maxLines="1"/>
    </LinearLayout>

    <TextView
        android:id="@+id/w_sanctuary_ayah"
        android:fontFamily="@font/thmanyah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="21sp"
        android:textStyle="bold"
        android:maxLines="2"/>

    <TextView
        android:id="@+id/w_sanctuary_trans"
        android:fontFamily="@font/thmanyah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#D9FFFFFF"
        android:textSize="11.5sp"
        android:maxLines="2"/>

    <TextView
        android:id="@+id/w_sanctuary_dhikr"
        android:fontFamily="@font/thmanyah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:gravity="center"
        android:textColor="#F5C84C"
        android:textSize="13.5sp"
        android:textStyle="bold"
        android:maxLines="1"/>
</LinearLayout>
