<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/w_hub_title"
            android:fontFamily="@font/thmanyah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="۞  Sahl Union"
            android:textColor="#F5C84C"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"/>
        <TextView
            android:id="@+id/w_hub_hijri"
            android:fontFamily="@font/thmanyah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D9FFFFFF"
            android:textSize="11.5sp"
            android:maxLines="1"/>
    </LinearLayout>

    <TextView
        android:id="@+id/w_hub_prayer"
        android:fontFamily="@font/thmanyah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:paddingBottom="8dp"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/w_hub_btn_search"
            android:fontFamily="@font/thmanyah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:background="@drawable/widget_pill_bg"
            android:textColor="#F5C84C"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/w_hub_btn_qibla"
            android:fontFamily="@font/thmanyah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:background="@drawable/widget_pill_bg"
            android:textColor="#F5C84C"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/w_hub_btn_tools"
            android:fontFamily="@font/thmanyah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:background="@drawable/widget_pill_bg"
            android:textColor="#F5C84C"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/w_hub_btn_apps"
            android:fontFamily="@font/thmanyah"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:gravity="center"
            android:background="@drawable/widget_pill_bg"
            android:textColor="#F5C84C"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
