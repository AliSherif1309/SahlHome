<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_icon_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:paddingTop="4dp">

    <FrameLayout
        android:layout_width="58dp"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/w_icon_img"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/w_icon_badge"
            android:fontFamily="@font/thmanyah"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:minWidth="18dp"
            android:layout_gravity="top|end"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:background="@drawable/widget_badge_bg"
            android:textColor="#072A22"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/w_icon_label"
        android:fontFamily="@font/thmanyah"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="3dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textSize="11.5sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
