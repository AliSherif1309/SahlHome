<resources>
    <style name="SahlTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/emerald</item>
        <item name="android:colorAccent">@color/emerald</item>
        <item name="android:colorControlNormal">@color/sub</item>
        <item name="android:colorControlActivated">@color/emerald</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/sub</item>
        <item name="android:textColorHint">@color/sub</item>
        <item name="android:editTextStyle">@style/SahlEdit</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/emerald_dark</item>
    </style>
    <style name="SahlHomeWallpaperTheme" parent="@style/SahlTheme">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
    <style name="SahlEdit" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/edit_bg</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/sub</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
